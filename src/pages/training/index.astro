---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { splitMarkdownTiers } from '@/lib/split-tiers';
import { termSlug } from '@/lib/term-id';
import { collectAllTags } from '@/lib/tags';
import { withBase } from '@/lib/base-path';
import { SITE_NAME } from '@/config/site';

const termsRaw = await getCollection('terms');

function extractOneLiner(md: string): string {
  const paragraphs = md
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean);
  return paragraphs[0] ?? '';
}

const quizTerms = termsRaw
  .map((t) => {
    const tiers = splitMarkdownTiers(t.body ?? '');
    const prompt = extractOneLiner(tiers.primary ?? '');
    return {
      slug: termSlug(t.id),
      titleJa: t.data.titleJa,
      titleEn: t.data.titleEn,
      tags: t.data.tags ?? [],
      prompt,
    };
  })
  .filter((t) => t.prompt.length > 0)
  .sort((a, b) => a.slug.localeCompare(b.slug, 'en'));

const tags = collectAllTags(termsRaw);
const quizDataJson = JSON.stringify(quizTerms).replace(/</g, '\\u003c');
const termsBaseHref = withBase('terms/');
---

<BaseLayout
  title="用語トレーニング"
  description={`${SITE_NAME}の用語を4択クイズで復習できるトレーニング機能です。`}
>
  <main class="container">
    <h1 class="page-title">用語トレーニング</h1>
    <p class="lede">
      4択クイズで用語を復習できます。間違えた用語はブラウザに保存され、あとで「苦手な用語だけ」出題できます。
    </p>

    <section id="training-setup" class="training-panel">
      <div class="training-setup-block">
        <h2 class="training-block-title">タグで絞り込む（未選択なら全用語）</h2>
        <div class="training-tag-list">
          {
            tags.map((tag) => (
              <label class="training-tag-option">
                <input type="checkbox" class="training-tag-check" value={tag} />
                <span>{tag}</span>
              </label>
            ))
          }
        </div>
      </div>

      <div class="training-setup-block">
        <h2 class="training-block-title">出題数</h2>
        <select id="training-count" class="training-select">
          <option value="5">5問</option>
          <option value="10" selected>10問</option>
          <option value="20">20問</option>
          <option value="999">できる限り全部</option>
        </select>
      </div>

      <div class="training-setup-block">
        <h2 class="training-block-title">苦手な用語の復習</h2>
        <p class="training-weak-status">
          現在の苦手な用語: <strong id="weak-count">0</strong> 件
        </p>
        <label class="training-tag-option">
          <input type="checkbox" id="weak-only" disabled />
          <span>苦手な用語だけで出題する（タグ選択より優先）</span>
        </label>
      </div>

      <p id="training-setup-error" class="training-error" hidden></p>

      <button type="button" id="training-start-btn" class="training-btn training-btn--primary">
        はじめる
      </button>
    </section>

    <section id="training-quiz" class="training-panel" hidden>
      <p class="training-progress">
        <span id="training-progress-text">1 / 10</span>
        <span class="training-direction-hint" id="training-direction-hint"></span>
      </p>
      <p class="training-instruction" id="training-instruction"></p>
      <h2 id="training-prompt" class="training-prompt"></h2>
      <div id="training-choices" class="training-choices"></div>
      <p id="training-feedback" class="training-feedback" hidden></p>
      <div class="training-quiz-actions">
        <button type="button" id="training-next-btn" class="training-btn training-btn--primary" hidden>
          次の問題へ
        </button>
      </div>
    </section>

    <section id="training-result" class="training-panel" hidden>
      <h2 class="training-block-title">結果</h2>
      <p id="training-score" class="training-score"></p>
      <div id="training-missed-wrap" hidden>
        <h3 class="training-block-title training-block-title--sub">間違えた用語</h3>
        <ul id="training-missed-list" class="training-missed-list"></ul>
      </div>
      <div class="training-result-actions">
        <button type="button" id="training-retry-same-btn" class="training-btn training-btn--primary">
          同じ条件でもう一度
        </button>
        <button type="button" id="training-retry-weak-btn" class="training-btn" hidden>
          間違えた用語だけ再挑戦
        </button>
        <button type="button" id="training-back-btn" class="training-btn">設定に戻る</button>
      </div>
    </section>

    <script
      is:inline
      type="application/json"
      id="training-data"
      data-terms-base={termsBaseHref}
      set:html={quizDataJson}
    ></script>
  </main>
</BaseLayout>

<style>
  .training-panel {
    margin-top: 1.5rem;
  }

  .training-setup-block {
    margin-bottom: 1.5rem;
  }

  .training-block-title {
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 0.6rem;
  }

  .training-block-title--sub {
    font-size: 0.95rem;
    margin-top: 1.25rem;
  }

  .training-tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .training-tag-option {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.9rem;
    cursor: pointer;
    user-select: none;
  }

  .training-tag-option:has(input:checked) {
    border-color: var(--link);
    color: var(--link);
  }

  .training-tag-option:has(input:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .training-select {
    padding: 0.5rem 0.75rem;
    font-size: 0.95rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
  }

  .training-weak-status {
    margin: 0 0 0.6rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .training-error {
    color: #dc2626;
    font-size: 0.9rem;
    margin: 0 0 1rem;
  }

  .training-btn {
    padding: 0.6rem 1.2rem;
    font-size: 0.95rem;
    font-weight: 700;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    margin: 0 0.5rem 0.5rem 0;
    transition: border-color 0.15s, background 0.15s, transform 0.1s;
  }

  .training-btn:hover {
    border-color: var(--card-hover-border, #d4d4d4);
  }

  .training-btn:active {
    transform: scale(0.98);
  }

  .training-btn--primary {
    background: var(--link);
    border-color: var(--link);
    color: #fff;
  }

  .training-btn--primary:hover {
    background: var(--link-hover);
    border-color: var(--link-hover);
  }

  .training-progress {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--muted);
    font-size: 0.88rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
  }

  .training-instruction {
    margin: 0 0 0.35rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .training-prompt {
    font-size: clamp(1.1rem, 3.2vw, 1.4rem);
    font-weight: 800;
    margin: 0 0 1.25rem;
    line-height: 1.5;
  }

  .training-choices {
    display: grid;
    gap: 0.6rem;
  }

  .training-choice {
    text-align: left;
    padding: 0.75rem 1rem;
    font-size: 0.98rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .training-choice:hover:not(:disabled) {
    border-color: var(--card-hover-border, #d4d4d4);
    box-shadow: var(--card-hover-shadow, 0 4px 24px rgba(0, 0, 0, 0.06));
  }

  .training-choice:disabled {
    cursor: default;
  }

  .training-choice.is-correct {
    border-color: #16a34a;
    background: rgba(34, 197, 94, 0.14);
  }

  .training-choice.is-wrong {
    border-color: #dc2626;
    background: rgba(239, 68, 68, 0.14);
  }

  .training-feedback {
    margin: 1rem 0;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    font-size: 0.95rem;
    background: var(--surface);
    border: 1px dashed var(--border);
  }

  .training-feedback.is-correct {
    border-color: #16a34a;
  }

  .training-feedback.is-wrong {
    border-color: #dc2626;
  }

  .training-feedback-link {
    display: inline-block;
    margin-top: 0.35rem;
    font-size: 0.88rem;
  }

  .training-score {
    font-size: 1.2rem;
    font-weight: 800;
  }

  .training-missed-list {
    margin: 0;
    padding-left: 1.2rem;
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .training-result-actions {
    margin-top: 1.5rem;
  }
</style>

<script>
  import { initTraining } from '@/scripts/training';
  initTraining();
</script>
